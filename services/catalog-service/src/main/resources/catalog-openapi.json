{
  "openapi": "3.0.3",
  "info": {
    "title": "SaniGest Catalog Service",
    "version": "0.1.0"
  },
  "paths": {
    "/actuator/health": {
      "get": {
        "operationId": "health",
        "summary": "Estado general de Catalog",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health/liveness": {
      "get": {
        "operationId": "liveness",
        "summary": "Estado del proceso de Catalog",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health/readiness": {
      "get": {
        "operationId": "readiness",
        "summary": "Disponibilidad de Catalog y PostgreSQL",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v3/api-docs": {
      "get": {
        "operationId": "apiDocs",
        "summary": "Contrato OpenAPI de Catalog",
        "responses": {
          "200": {
            "description": "Documento OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clients": {
      "post": {
        "operationId": "createClient",
        "summary": "Registrar un cliente",
        "description": "Requiere CATALOG_WRITE en la membresía activa resuelta por Company. El cliente se registra en la empresa autorizada.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente creado en la empresa autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientCreated"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido"
          },
          "403": {
            "description": "Alta sin autorización empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Identificación fiscal duplicada en la empresa",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No se pudo verificar la autorización empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateClientRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "Se elimina el espacio en blanco ASCII en los extremos. Un resultado vacío se guarda como null. Se conservan letras y separadores."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "maxLength": 320
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9+() .-]{7,32}$"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          }
        }
      },
      "ClientCreated": {
        "type": "object",
        "required": [
          "id",
          "name",
          "taxId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
