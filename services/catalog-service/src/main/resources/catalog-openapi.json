{
  "openapi": "3.0.3",
  "info": {
    "title": "SaniGest Catalog Service",
    "version": "0.1.0"
  },
  "paths": {
    "/actuator/health": {
      "get": {
        "operationId": "health",
        "summary": "Estado general de Catalog",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health/liveness": {
      "get": {
        "operationId": "liveness",
        "summary": "Estado del proceso de Catalog",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health/readiness": {
      "get": {
        "operationId": "readiness",
        "summary": "Disponibilidad de Catalog y PostgreSQL",
        "responses": {
          "200": {
            "description": "Operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "No disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v3/api-docs": {
      "get": {
        "operationId": "apiDocs",
        "summary": "Contrato OpenAPI de Catalog",
        "responses": {
          "200": {
            "description": "Documento OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clients": {
      "post": {
        "operationId": "createClient",
        "summary": "Registrar un cliente",
        "description": "Requiere CATALOG_WRITE en la membresía activa resuelta por Company. El cliente se registra en la empresa autorizada.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente creado en la empresa autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientCreated"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido"
          },
          "403": {
            "description": "Alta sin autorización empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Identificación fiscal duplicada en la empresa",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No se pudo verificar la autorización empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listClients",
        "summary": "Listar y buscar clientes",
        "description": "Requiere CATALOG_READ en la membresía activa resuelta por Company. El orden es name ASC, id ASC. Una página fuera de rango devuelve content vacío y conserva los totales de la búsqueda.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Fragmento literal del nombre o documento fiscal, sin distinguir mayúsculas. Se recortan espacios exteriores y se omite el filtro si queda vacío.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "ACTIVE o INACTIVE, sin distinguir mayúsculas. Se recortan espacios exteriores y se omite el filtro si queda vacío. INACTIVE devuelve una página vacía mientras no haya clientes inactivos.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Índice de página desde cero.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Registros por página. El máximo por defecto es 100 y se configura con sanigest.catalog.clients.max-page-size.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de clientes de la empresa autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientPage"
                },
                "example": {
                  "content": [
                    {
                      "id": "a37149a5-d44b-4467-8805-09a8df3718ca",
                      "name": "Clínica Ejemplo",
                      "taxId": "101001001",
                      "status": "ACTIVE"
                    }
                  ],
                  "page": 0,
                  "size": 20,
                  "totalElements": 1,
                  "totalPages": 1
                }
              }
            }
          },
          "400": {
            "description": "Filtros o paginación inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido"
          },
          "403": {
            "description": "Consulta sin autorización de lectura empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No se pudo verificar la autorización empresarial",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateClientRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "taxId": {
            "type": "string",
            "nullable": true,
            "maxLength": 64,
            "description": "Se elimina el espacio en blanco ASCII en los extremos. Un resultado vacío se guarda como null. Se conservan letras y separadores."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "maxLength": 320
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9+() .-]{7,32}$"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          }
        }
      },
      "ClientCreated": {
        "type": "object",
        "required": [
          "id",
          "name",
          "taxId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ListedClient": {
        "type": "object",
        "required": [
          "id",
          "name",
          "taxId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "ClientPage": {
        "type": "object",
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListedClient"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
