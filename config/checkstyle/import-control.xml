<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
        "-//Checkstyle//DTD ImportControl Configuration 1.5//EN"
        "https://checkstyle.org/dtds/import_control_1_5.dtd">

<import-control pkg="com.sanigest" strategyOnMismatch="allowed">
    <subpackage name="company|identity" regex="true">
        <subpackage name="domain">
            <disallow pkg="com\.sanigest\.(company|identity)\.(api|application|infrastructure)" regex="true"/>
            <disallow pkg="org.springframework"/>
            <disallow pkg="org.hibernate"/>
            <disallow pkg="jakarta.persistence"/>
        </subpackage>
        <subpackage name="application">
            <disallow pkg="com\.sanigest\.(company|identity)\.(api|infrastructure)" regex="true"/>
            <disallow pkg="org.springframework.dao"/>
            <disallow pkg="org.springframework.jdbc"/>
            <disallow pkg="org.springframework.data"/>
            <disallow pkg="org.hibernate"/>
            <disallow pkg="jakarta.persistence"/>
        </subpackage>
        <subpackage name="api">
            <disallow pkg="com\.sanigest\.(company|identity)\.infrastructure" regex="true"/>
        </subpackage>
    </subpackage>
</import-control>
