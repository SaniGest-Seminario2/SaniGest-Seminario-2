<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
        "-//Checkstyle//DTD ImportControl Configuration 1.5//EN"
        "https://checkstyle.org/dtds/import_control_1_5.dtd">

<import-control pkg="com.sanigest" strategyOnMismatch="allowed">
    <subpackage name="company|identity|catalog" regex="true">
        <subpackage name="domain">
            <disallow pkg="com\.sanigest\.(company|identity|catalog)\.(api|application|infrastructure)" regex="true"/>
            <disallow pkg="org.springframework"/>
            <disallow pkg="org.hibernate"/>
            <disallow pkg="jakarta.persistence"/>
        </subpackage>
        <subpackage name="application">
            <disallow pkg="com\.sanigest\.(company|identity|catalog)\.(api|infrastructure)" regex="true"/>
            <disallow pkg="org.springframework.dao"/>
            <disallow pkg="org.springframework.jdbc"/>
            <disallow pkg="org.springframework.data"/>
            <disallow pkg="org.springframework.web"/>
            <disallow pkg="org.springframework.http"/>
            <disallow pkg="org.hibernate"/>
            <disallow pkg="jakarta.persistence"/>
        </subpackage>
        <subpackage name="api">
            <disallow pkg="com\.sanigest\.(company|identity|catalog)\.infrastructure" regex="true"/>
            <subpackage name="controller">
                <disallow pkg="com\.sanigest\.(company|identity|catalog)\.application\.port\.out\.persistence" regex="true"/>
                <disallow pkg="org.springframework.data"/>
                <disallow pkg="org.springframework.jdbc"/>
                <disallow pkg="jakarta.persistence"/>
            </subpackage>
        </subpackage>
        <subpackage name="infrastructure">
            <disallow pkg="com.sanigest.catalog.api"/>
        </subpackage>
    </subpackage>
</import-control>
