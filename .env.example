# Copia este archivo como .env. Estos valores son exclusivamente para desarrollo local.
# Cuenta administrativa usada exclusivamente por el contenedor y el bootstrap.
POSTGRES_ADMIN_USER=sanigest_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin-local-only
POSTGRES_PORT=5432

# Cada servicio usa únicamente su propio rol/base. No reutilizar contraseñas fuera de local.
IDENTITY_DB_NAME=sanigest_identity
IDENTITY_DB_USER=sanigest_identity
IDENTITY_DB_PASSWORD=change-me-identity-local-only
COMPANY_DB_NAME=sanigest_company
COMPANY_DB_USER=sanigest_company
COMPANY_DB_PASSWORD=change-me-company-local-only
CATALOG_DB_NAME=sanigest_catalog
CATALOG_DB_USER=sanigest_catalog
CATALOG_DB_PASSWORD=change-me-catalog-local-only
SALES_DB_NAME=sanigest_sales
SALES_DB_USER=sanigest_sales
SALES_DB_PASSWORD=change-me-sales-local-only
EXPENSE_DB_NAME=sanigest_expense
EXPENSE_DB_USER=sanigest_expense
EXPENSE_DB_PASSWORD=change-me-expense-local-only
FINANCE_DB_NAME=sanigest_finance
FINANCE_DB_USER=sanigest_finance
FINANCE_DB_PASSWORD=change-me-finance-local-only

# Valkey es una cache reconstruible, no una fuente de verdad.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me-local-only
CACHE_DEFAULT_TTL=5m

